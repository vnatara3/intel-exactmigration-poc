<?xml version="1.0" encoding="utf-8"?><!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd"[]><!-- Original file name: DABF1019-23BE-41CC-A167-A8169C2D017A.dita --><topic id="GUID-BB898775-4F12-4AD2-ACFB-2281781AA687" xml:lang="en-US"><title>LPDDR5/x CAMM x32 Type 3</title><body><section id="SECTION_DABF1019-23BE-41CC-A167-A8169C2D017A"><p>Pcb Type &amp; Thickness: Type-3, 0.8mm</p><fig id="FIG_LPDDR5_X_CAMM_X32_TYPE_3_DQ_DQS_CA_CS_CLK_TOPOLOGY_DIAGRAM_1"><title>LPDDR5/x CAMM x32 Type 3 DQ, DQS, CA, CS, CLK Topology Diagram</title><image href="../images/GUID-3803C381-68B4-4E55-B193-4A709F497822.png" scalefit="yes" id="IMG_LPDDR5_X_CAMM_X32_TYPE_3_DQ_DQS_CA_CS_CLK_TOPOLOGY_DIAGRAM_1_PNG" /></fig><fig id="FIG_LPDDR5_X_CAMM_X32_TYPE_3_WCK_TOPOLOGY_DIAGRAM_1"><title>LPDDR5/x CAMM x32 Type 3 WCK Topology Diagram</title><image href="../images/GUID-DD0AD9B5-62A3-4F6B-ACEC-2BCF3BE0863C.png" scalefit="yes" id="IMG_LPDDR5_X_CAMM_X32_TYPE_3_WCK_TOPOLOGY_DIAGRAM_1_PNG" /></fig><fig id="FIG_LPDDR5_X_CAMM_X32_TYPE_3_RESET_AND_RCOMP_TOPOLOGY_DIAGRAM_1"><title>LPDDR5/x CAMM x32 Type 3 Reset and RCOMP Topology Diagram</title><image href="../images/GUID-584D3EF1-8AEA-4613-B8BC-8A4DB05A3AF2.png" scalefit="yes" id="IMG_LPDDR5_X_CAMM_X32_TYPE_3_RESET_AND_RCOMP_TOPOLOGY_DIAGRAM_1_PNG" /></fig><fig id="FIG_LPDDR5_X_CAMM_X32_TYPE_3_BLOCK_DIAGRAM_1"><title>LPDDR5/x CAMM x32 Type 3 Block Diagram</title><image href="../images/GUID-FFCEB16A-2A62-486F-BD4E-A2DF331A0929.png" scalefit="yes" id="IMG_LPDDR5_X_CAMM_X32_TYPE_3_BLOCK_DIAGRAM_1_PNG" /></fig><fig id="FIG_LPDDR5_X_CAMM_X32_TYPE_3_LENGTH_MATCHING_PRINCIPLE_1"><title>LPDDR5/x CAMM x32 Type 3 Length Matching Principle</title><image href="../images/GUID-03655939-F5A5-4FEC-B440-7295D0F27310.png" scalefit="yes" id="IMG_LPDDR5_X_CAMM_X32_TYPE_3_LENGTH_MATCHING_PRINCIPLE_1_PNG" /></fig><table id="TABLE_DABF1019-23BE-41CC-A167-A8169C2D017A_1"><title>LPDDR5/x CAMM x32 Type 3 Notes</title><tgroup cols="2"><thead><row><entry>Note</entry><entry>Detail</entry></row></thead><tbody><row><entry><p>PCB stackup</p></entry><entry><p>Type-3 stackup with minimum of 8 layers.</p></entry></row><row><entry><p>Layer assignment rules</p></entry><entry><p>Outer row DQ/RDQS/WCK on layer 3, Inner row DQ/RDQS/WCK on layer 7, CA/CS/CLK on layer 5.</p></entry></row><row><entry><p>Reference plane</p></entry><entry><p>Continuous ground only.</p></entry></row><row><entry><p>Number of vias allowed</p></entry><entry><p>DQ/ RDQS/ CA/ CS/ CLK/ WCK: Max 2 vias in total.</p><p /></entry></row><row><entry><p>GND stitching</p></entry><entry><p>For VSS stitching using microvia, target a minimum S:G ratio of 1:1 at signal layer transition.  </p><p>For VSS stitching using PTH, target a minimum S:G ratio of 2:1 at signal layer transition.</p><p>VSS via stitching pattern to be copied exactly from RVP/ clip files.</p></entry></row><row><entry><p>Max MS BO/ BI length</p></entry><entry><p>Refer to RFI/ EMC guidelines for the maximum microstrip BO/ BI length requirement.</p></entry></row><row><entry><p>Serpentine routing</p></entry><entry><p>Use 3x of dielectric height for serpentine routing spacing.</p></entry></row><row><entry><p>Bit/ Byte swapping rule</p></entry><entry><p>Bit swapping is allowed within each Byte for all memory technologies. </p><p>Byte swapping is allowed within a 16-bit channel.</p><p>LPDDR5: x16 sub-channels can be swizzled within their x64 MC.</p><p>When swapping channel DQ, the CA/CS signals must be swapped as well.</p></entry></row><row><entry><p>Unused signals</p></entry><entry><p>Leave unused DDR signals (PARITY, extra CA) floating (no connect). ALERT is also unused and can be left floating (no connect) at CPU side.</p></entry></row><row><entry><p>Rtt/ Ctt for RESET</p></entry><entry><p>Keep R1 empty; R2 = 0 Ohm; C1 = 0.1 uF (no stuff).</p></entry></row><row><entry><p>RCOMP value</p></entry><entry><p>100 Ohm</p></entry></row></tbody></tgroup></table></section><section id="SECTION_SYSTEM_MEMORY_B2B8A509-F831-4A1A-8A10-9E395B2EE0B2_DABF1019-23BE-41CC-A167-A8169C2D017A_LENGTH_MATCHING"><title>Length Matching</title><table id="TABLE_SYSTEM_MEMORY_B2B8A509-F831-4A1A-8A10-9E395B2EE0B2_DABF1019-23BE-41CC-A167-A8169C2D017A_LENGTH_MATCHING_1"><title>LPDDR5/x CAMM x32 Type 3 Length Matching</title><tgroup cols="2"><thead><row><entry>Matching Groups</entry><entry>Relationship</entry></row></thead><tbody><row><entry><p>Length matching between DQ and WCK per x16</p></entry><entry><p> -8 mm &lt; DQ - WCK &lt; 12.8 mm</p></entry></row><row><entry><p>Length matching between DQ and RDQS per x8</p></entry><entry><p>-2.4 mm &lt; DQ - RDQS &lt; 2.4 mm</p></entry></row><row><entry><p>Length matching between WCK and CLK per x16</p></entry><entry><p>-4 mm &lt; WCK - CLK &lt; 8 mm</p></entry></row><row><entry><p>Length matching between DQ signals per x8</p></entry><entry><p>&lt;3.975 mm</p></entry></row><row><entry><p>Length matching between channel-to-channel CLK signals</p></entry><entry><p>&lt; 20mm</p></entry></row><row><entry><p>Length matching between CLK and CA bits per x16</p></entry><entry><p> -4 mm &lt; CLK - CA &lt; 4 mm</p></entry></row><row><entry><p>Length matching between CA bits per x16</p></entry><entry><p>&lt;7.475 mm</p></entry></row><row><entry><p>Length matching between CLK and CS per x16</p></entry><entry><p>-10 mm &lt; CLK - CS &lt; 10 mm</p></entry></row><row><entry><p>Length matching between CS bits per x16</p></entry><entry><p>&lt;8 mm</p></entry></row><row><entry><p>Length matching between RDQS_N and RDQS_P</p></entry><entry><p>&lt;50 um</p></entry></row><row><entry><p>Length matching between WCK_N and WCK_P</p></entry><entry><p>&lt;50 um</p></entry></row><row><entry><p>Length matching between CLK_N and CLK_P</p></entry><entry><p>&lt;50 um</p></entry></row><row><entry><p>Length matching between Tee segment (BI2) on WCK_N/P</p></entry><entry><p>&lt;0 um</p></entry></row><row><entry><p>Include package length in length matching</p></entry><entry><p>Required</p></entry></row><row><entry><p>Note</p></entry><entry><p>Length matching should be done in the main route segment only.</p></entry></row></tbody></tgroup></table></section><section id="SECTION_9103D68B-288B-4406-A2CA-ADC6D1688AEC"><title>CA/CS, CH-0/CH-1/CH-2/CH-3/CH-4/CH-5/CH-6/CH-7, All</title><table id="TABLE_9103D68B-288B-4406-A2CA-ADC6D1688AEC_1"><title>LPDDR5/x CAMM x32 Type 3 CA/CS, CH-0/CH-1/CH-2/CH-3/CH-4/CH-5/CH-6/CH-7, All Routing Guidelines</title><tgroup cols="4"><thead><row><entry>Segment</entry><entry>Tline Type</entry><entry>Max Length Segment (mm)</entry><entry>Max Length Segment Note</entry></row></thead><tbody><row><entry><p>BO1</p></entry><entry><p>MS</p></entry><entry><p>7.4</p></entry><entry><p /></entry></row><row><entry><p>BO2</p></entry><entry><p>SL</p></entry><entry><p /></entry><entry><p>17.5 - BO1</p></entry></row><row><entry><p>M</p></entry><entry><p>SL</p></entry><entry><p /></entry><entry><p /></entry></row><row><entry><p>BI1</p></entry><entry><p>SL</p></entry><entry><p>17.2</p></entry><entry><p /></entry></row><row><entry><p>BI2</p></entry><entry><p>MS</p></entry><entry><p>6.1</p></entry><entry><p /></entry></row></tbody></tgroup></table><p>Max Length Total (mm): 70</p><p>Max Length Total Note: Max length is package + motherboard.</p></section><section id="SECTION_94736870-4F05-4763-98EA-ED89AB6129DE"><title>CLK, CH-0/CH-1/CH-2/CH-3/CH-4/CH-5/CH-6/CH-7, All</title><table id="TABLE_94736870-4F05-4763-98EA-ED89AB6129DE_1"><title>LPDDR5/x CAMM x32 Type 3 CLK, CH-0/CH-1/CH-2/CH-3/CH-4/CH-5/CH-6/CH-7, All Routing Guidelines</title><tgroup cols="4"><thead><row><entry>Segment</entry><entry>Tline Type</entry><entry>Max Length Segment (mm)</entry><entry>Max Length Segment Note</entry></row></thead><tbody><row><entry><p>BO1</p></entry><entry><p>MS</p></entry><entry><p>6.4</p></entry><entry><p /></entry></row><row><entry><p>BO2</p></entry><entry><p>SL</p></entry><entry><p /></entry><entry><p>16 - BO1</p></entry></row><row><entry><p>M</p></entry><entry><p>SL</p></entry><entry><p /></entry><entry><p /></entry></row><row><entry><p>BI1</p></entry><entry><p>SL</p></entry><entry><p>19.5</p></entry><entry><p /></entry></row><row><entry><p>BI2</p></entry><entry><p>MS</p></entry><entry><p>0.8</p></entry><entry><p /></entry></row></tbody></tgroup></table><p>Max Length Total (mm): 70</p><p>Max Length Total Note: Max length is package + motherboard.</p></section><section id="SECTION_111FFC0E-51D6-4B61-BBB5-BF58B3F6D938"><title>DQ, CH-0/CH-1/CH-2/CH-3/CH-4/CH-5/CH-6/CH-7, All</title><table id="TABLE_111FFC0E-51D6-4B61-BBB5-BF58B3F6D938_1"><title>LPDDR5/x CAMM x32 Type 3 DQ, CH-0/CH-1/CH-2/CH-3/CH-4/CH-5/CH-6/CH-7, All Routing Guidelines</title><tgroup cols="4"><thead><row><entry>Segment</entry><entry>Tline Type</entry><entry>Max Length Segment (mm)</entry><entry>Max Length Segment Note</entry></row></thead><tbody><row><entry><p>BO1</p></entry><entry><p>MS</p></entry><entry><p>6.5</p></entry><entry><p /></entry></row><row><entry><p>BO2</p></entry><entry><p>SL</p></entry><entry><p /></entry><entry><p>18 - BO1</p></entry></row><row><entry><p>M</p></entry><entry><p>SL</p></entry><entry><p /></entry><entry><p /></entry></row><row><entry><p>BI2</p></entry><entry><p>MS</p></entry><entry><p>0.8</p></entry><entry><p /></entry></row></tbody></tgroup></table><p>Max Length Total (mm): 70</p><p>Max Length Total Note: Max length is package + motherboard.</p></section><section id="SECTION_0C6F416E-D50D-464B-A4D2-ADBCBAAFB3FC"><title>RCOMP, MISC, All</title><table id="TABLE_0C6F416E-D50D-464B-A4D2-ADBCBAAFB3FC_1"><title>LPDDR5/x CAMM x32 Type 3 RCOMP, MISC, All Routing Guidelines</title><tgroup cols="3"><thead><row><entry>Segment</entry><entry>Tline Type</entry><entry>Max Length Segment (mm)</entry></row></thead><tbody><row><entry><p>M</p></entry><entry><p>MS, SL</p></entry><entry><p>12.7</p></entry></row></tbody></tgroup></table><p>Max Length Total (mm): 12.7</p></section><section id="SECTION_515EB1C8-5CB4-422E-ABE4-CBA43FF27DD8"><title>RDQS, CH-