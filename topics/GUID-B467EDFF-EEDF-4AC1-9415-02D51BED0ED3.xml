  <title class="- topic/title ">No-Eviction Mode (NEM) Sizes</title> 
  <body class="- topic/body "> 
    <draft-comment translate="no" class="- topic/draft-comment ">Converted using FMHtml2Dita version: 2.1.0 
    </draft-comment> 
    <table id="GUID-C9EF598D-15D8-4A72-98E7-F6361FAFB454" class="- topic/table "> 
      <tgroup cols="3" class="- topic/tgroup "> 
        <colspec colnum="1" colname="col1" colwidth="1.00*" class="- topic/colspec " /> 
        <colspec colnum="2" colname="col2" colwidth="2.63*" class="- topic/colspec " /> 
        <colspec colnum="3" colname="col3" colwidth="3.83*" class="- topic/colspec " /> 
        <thead class="- topic/thead "> 
          <row valign="middle" class="- topic/row "> 
            <entry class="- topic/entry "> Step 
            </entry> 
            <entry class="- topic/entry "> Description 
            </entry> 
            <entry class="- topic/entry "> Details 
            </entry> 
          </row></thead> 
        <tbody class="- topic/tbody "> 
          <row class="- topic/row "> 
            <entry morerows="2" class="- topic/entry "> 1 
            </entry> 
            <entry morerows="2" class="- topic/entry "> Get the cache size of L3 via CPUID leaf 4 of BSP. 
            </entry> 
            <entry class="- topic/entry "> If values returned for L3 are all zeros, NEM is supported by L2 cache, else by L3. 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col3" class="- topic/entry "> L2:WAY_MASK_1=MSR 0xD11, WAY_MASK_2=MSR 0xD12 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col3" class="- topic/entry "> L3:WAY_MASK_1=MSR 0xC91, WAY_MASK_2=MSR 0xC92 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry morerows="1" class="- topic/entry "> 2 
            </entry> 
            <entry morerows="1" class="- topic/entry "> Get the cache size of NEM supported cache level via CPUID leaf 4 of BSP. 
            </entry> 
            <entry class="- topic/entry "> CacheSize (Bytes) = (WayCnt) * (PartitionCnt) * (LineSize) * (SetCnt) = 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col3" class="- topic/entry "> (EBX[31:22] + 1) * (EBX[21:12] + 1) * (EBX[11:0] + 1) * (ECX + 1) 
            </entry> 
          </row> 
           
          <row class="- topic/row ">
            <entry morerows="1" class="- topic/entry "> 2 
            </entry>
            <entry morerows="1" class="- topic/entry "> Get the cache size of NEM supported cache level via CPUID leaf 4 of BSP. 
            </entry> 
            <entry colname="col3" class="- topic/entry "> L3: ACMways = 0 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col3" class="- topic/entry "> WayCnt = (EBX[31:22] + 1) 
            </entry> 
          </row> 
          <row class="- topic/row ">
            <entry colname="col1" class="- topic/entry "> 3 
            </entry> 
            <entry colname="col2" class="- topic/entry "> If ACM takes a number of ways reduce that. 
            </entry> 
            <entry class="- topic/entry "> EffWayCnt = WayCnt - ACMways 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry morerows="1" class="- topic/entry "> 4 
            </entry> 
            <entry morerows="1" class="- topic/entry "> Recalculate NEM size. 
            </entry> 
            <entry class="- topic/entry "> EffCacheSize= EffWayCnt * previous_power_of_two(CacheSize/WayCnt)) 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col3" class="- topic/entry "> EffCacheSize= EffWayCnt * previous_power_of_two( (EBX[21:12] + 1) * (EBX[11:0] + 1) * (ECX + 1)) 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry class="- topic/entry "> 5 
            </entry> 
            <entry class="- topic/entry "> Compute required guard band (GB). 
            </entry> 
            <entry class="- topic/entry "> GbSize = EffCacheSize / EffWayCnt 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry morerows="3" class="- topic/entry "> 6 
            </entry> 
            <entry class="- topic/entry "> Compute NEM size based on number of contiguous ranges 
            </entry> 
            <entry class="- topic/entry "> 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col2" class="- topic/entry "> 1 NEM range 
            </entry> 
            <entry class="- topic/entry "> NemSize = EffCacheSize 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col2" class="- topic/entry "> 2 NEM ranges 
            </entry> 
            <entry class="- topic/entry "> NemSize = EffCacheSize - GbSize 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry colname="col2" class="- topic/entry "> 3 NEM ranges 
            </entry> 
            <entry class="- topic/entry "> NemSize = EffCacheSize - (2*GbSize) 
            </entry> 
          </row> 
        </tbody> 
      </tgroup> 
    </table> 
  </body> 
