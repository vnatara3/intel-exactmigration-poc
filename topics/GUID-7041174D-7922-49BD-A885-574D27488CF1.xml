        </entry> 
        <entry class="- topic/entry "> 1 
        </entry> 
        <entry class="- topic/entry "> 17 
        </entry> 
        <entry class="- topic/entry "> 2Ch 
        </entry> 
        <entry class="- topic/entry "> Bit size limit of the BASE_LBA field of the TSE Table. 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry class="- topic/entry "> IOCCE MMIO Base 
        </entry> 
        <entry class="- topic/entry "> 8 
        </entry> 
        <entry class="- topic/entry "> 18 
        </entry> 
        <entry class="- topic/entry "> Dynamic 
        </entry> 
        <entry class="- topic/entry "> Base Address of the IOCCE MMIO range. 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry class="- topic/entry "> IOCCE MMIO Limit 
        </entry> 
        <entry class="- topic/entry "> 8 
        </entry> 
        <entry class="- topic/entry "> 26 
        </entry> 
        <entry class="- topic/entry "> IOCCE Base + 3FFh 
        </entry> 
        <entry class="- topic/entry "> Address Limit of the IOCCE MMIO range. 
        </entry> 
      </row> 
      <row class="- topic/row "> 
