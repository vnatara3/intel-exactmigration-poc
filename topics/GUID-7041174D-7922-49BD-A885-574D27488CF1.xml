        </entry> 
        <entry morerows="1" class="- topic/entry "> 1 
        </entry> 
        <entry morerows="1" class="- topic/entry "> 14 
        </entry> 
        <entry morerows="1" class="- topic/entry "> 
          <u class="+ topic/ph hi-d/u "> TSE_</u> IOCCE_Capability. PageSizeSupported 
        </entry> 
        <entry colname="col5" class="- topic/entry "> Bit 0: 4K 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry class="- topic/entry ">Bit 1: 2M 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry morerows="1" class="- topic/entry "> Granularity of LBA 
        </entry> 
        <entry morerows="1" colname="col2" class="- topic/entry "> 1 
        </entry> 
        <entry morerows="1" colname="col3" class="- topic/entry "> 15 
        </entry> 
        <entry morerows="1" colname="col4" class="- topic/entry "> 
          <u class="+ topic/ph hi-d/u "> TSE_</u> IOCCE_Capability. LBA_Granularity 
        </entry> 
        <entry colname="col5" class="- topic/entry "> Bit 0: 512 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry class="- topic/entry ">Bit 1: 4K 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry morerows="2" class="- topic/entry "> Data Transfer Alignment 
        </entry> 
        <entry morerows="2" class="- topic/entry "> 1 
        </entry> 
        <entry morerows="2" class="- topic/entry "> 16 
        </entry> 
        <entry morerows="2" class="- topic/entry "> 
          <u class="+ topic/ph hi-d/u "> TSE_</u> IOCCE_Capability. DataTransferAlignment 
        </entry> 
        <entry colname="col5" class="- topic/entry "> BIT0: 4B alignment 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry colname="col5" class="- topic/entry "> BIT1: 8B alignment 
        </entry> 
      </row> 
      <row class="- topic/row "> 
        <entry class="- topic/entry "> BIT2: 16B alignment 
        </entry> 
      </row> 
      <row class="- topic/row "> 
