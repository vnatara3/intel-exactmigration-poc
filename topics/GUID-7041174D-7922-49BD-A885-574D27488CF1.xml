    <colspec colnum="5" colname="col5" colwidth="2.24*" class="- topic/colspec " /> 
    <thead class="- topic/thead "> 
      <row valign="middle" class="- topic/row "> 
        <entry class="- topic/entry "> 
          <b class="+ topic/ph hi-d/b "> Field</b> 
        </entry> 
        <entry class="- topic/entry "> 
          <b class="+ topic/ph hi-d/b "> Byte Length</b> 
        </entry> 
        <entry class="- topic/entry "> 
