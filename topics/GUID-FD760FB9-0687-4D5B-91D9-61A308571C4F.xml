        <colspec colnum="3" colname="col3" colwidth="3.20*" class="- topic/colspec " /> 
        <colspec colnum="4" colname="col4" colwidth="1.52*" class="- topic/colspec " /> 
        <colspec colnum="5" colname="col5" colwidth="6.63*" class="- topic/colspec " /> 
        <thead class="- topic/thead "> 
          <row class="- topic/row "> 
            <entry class="- topic/entry "> 
            </entry> 
            <entry class="- topic/entry "> Offset 
            </entry> 
            <entry class="- topic/entry "> 
            </entry> 
            <entry class="- topic/entry "> 
            </entry> 
            <entry class="- topic/entry "> 
              <b class="+ topic/ph hi-d/b "> Recommendation</b> 
            </entry> 
          </row></thead> 
        <tbody class="- topic/tbody "> 
          <row class="- topic/row "> 
            <entry class="- topic/entry "> Global DLVR RFI Mitigation enable/disable 
            </entry> 
            <entry class="- topic/entry "> 
            </entry> 
            <entry class="- topic/entry "> 
            </entry> 
            <entry class="- topic/entry "> 
            </entry> 
            <entry class="- topic/entry "> Enable 
            </entry> 
          </row> 
          <row class="- topic/row "> 
            <entry class="- topic/entry "> RFI_EMI_CONTROL_0_0_0_MCHBAR 
            </entry> 
            <entry class="- topic/entry "> 0x5A08 
            </entry> 
            <entry class="- topic/entry "> SSC_FREQ_SPRD 
            </entry> 
            <entry class="- topic/entry "> 4:0 
            </entry> 
            <entry class="- topic/entry "> Default - 0.5% Options for customers to choose: 0%, 0.5%, 1%, 2%, 4% 
