					 </entry> 
					 <entry valign="middle" align="center" morerows="2">1.244 
					 </entry> 
					 <entry valign="middle" align="center" morerows="2">0.25 
					 </entry> 
					 <entry valign="middle" align="center" morerows="2">1.49 ± 0.11 
					 </entry> 
				  </row> 
				  <row valign="middle"> 
					 <entry align="center" valign="middle"><b> NVL 16C 4X<sup>e</sup> / 
						  <b>NVL 14C 4X<sup>e</sup> /</b> NVL HX16C</b> 
					 </entry> 
					 <entry valign="middle" align="center">#<xref href="https://cdrdv2.intel.com/V1/DL/GETCONTENT/858127" format="https" scope="external">858127</xref> / N80222 
					 </entry> 
				  </row> 
				  <row valign="middle"> 
					 <entry align="center" valign="middle"><b> NVL 16C 12X<sup>e</sup></b> 
					 </entry> 
					 <entry valign="middle" align="center">#<xref href="https://cdrdv2.intel.com/V1/DL/GETCONTENT/858127" format="https" scope="external">858127</xref> / N91014 
					 </entry> 
				  </row> 
				  <row valign="middle"> 
					 <entry align="center" valign="middle"><b> NVL-HX 28C/24C</b> 
					 </entry> 
					 <entry valign="middle" align="center">#<xref href="https://cdrdv2.intel.com/V1/DL/GETCONTENT/858127" format="https" scope="external">858127</xref> / N73478 
					 </entry> 
					 <entry valign="middle" align="center">1.871 
					 </entry> 
					 <entry valign="middle" align="center">0.20 
					 </entry> 
					 <entry valign="middle" align="center">2.07 ± 0.12 
					 </entry> 
				  </row> 
				</tbody> 
			 </tgroup> 
		  </table> 
		</li> 
		<li id="LI_A36D93A18C2F4896B236938A0C713721">This estimated package height accounts for the combined effects, after SMT reflow, of multiple components of the total package height: 
		  <ul id="UL_A56ADD22C74C41E5921A50C2D7E114BA"> 
			 <li id="LI_A82CC563E4274FEEB36D22A941099CD7">Solder paste thickness 
			 </li> 
			 <li id="LI_1FCF5D08D0F742CAA7B1DEF721CCDEA4">BGA height after SMT reflow 
			 </li> 
			 <li id="LI_34EA5CF9830C43BEAE6728C9480C50F1">Package + board warpage after SMT reflow 
			 </li> 
		  </ul> 
		</li> 
	 </ol> 
  </body> 
