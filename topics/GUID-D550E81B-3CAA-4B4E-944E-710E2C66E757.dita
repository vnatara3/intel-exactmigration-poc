                </li> 
                <li id="LI_2546FFE2548B40089556BEAC7AC73975"> PS Cutoff Current 
                </li> 
                <li id="LI_E0D874FB8AF54F4399EC653207FB3FB4"> IMON 
                </li> 
                <li id="LI_092B49E450A741F9BFEBC635882863C8"> Icc Max 
                </li> 
                <li id="LI_17B3739592E44ECBBB83418D0A0360AA"> Fast V Mode IccLimit 
                </li> 
                <li id="LI_7820A92EC5E54CF48692AFC893D7A7D3"> VR Voltage Limit 
                </li> 
                <li id="LI_AAF18B8E8A904AA7ACFF734DBF703C68"> VR TDC Settings 
                </li> 
                <li id="LI_4DC5CCC61F4D4D609B162D024DD3E6AD"> PS1 to PS0 Dynamic Cutoff 
                </li> 
                <li id="LI_EB961512E9964FE196B3E50D933CED7C"> PS2 to PS1 Dynamic Cutoff 
                </li> 
                <li id="LI_6ECB9B1462334D429621CA99FB3C75CC"> VccIn Demotion 
                </li> 
                <li id="LI_A6CB048742C74BF4A1A3D8CEDB66DD92"> Acoustic Noise Mitigation 
                </li> 
              </ol> 
            </li> 
          </ol> 
        </li> 
        <li id="LI_913F3A9B079C4A9894B8687955F795B1"> If return data = 1 - request is granted - pcode has acked the request. 
          <ol id="OL_33B6B4CBA2664934B272E71FD798B478"> 
            <li id="LI_FEBCFA08F2EE467A91594A13C1F930B6"> FIVR RFI settings based on XTAL clock frequency. 
            </li> 
          </ol> 
        </li> 
        <li id="LI_DC3B9C4198F9449990337831417A1E59">Phase Modulation 
        </li> 
      </ol> 
      </p> 
