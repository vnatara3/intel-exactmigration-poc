<?xml version="1.0" encoding="utf-8"?><!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd"[]><!-- Original file name: B0E4F849-15E2-4CB7-8CF1-B9B4859B510A.dita --><topic id="GUID-5028AAF4-4FDD-49DF-9229-9CB714E2E2B4" xml:lang="en-US"><title>SODIMM 1DPC</title><body><section id="SECTION_B0E4F849-15E2-4CB7-8CF1-B9B4859B510A"><p>Pcb Type &amp; Thickness: Type-3, 0.9mm</p><fig id="FIG_DDR5_SODIMM_TYPE-3_10L_SIGNALS_TOPOLOGIES_1"><title>DDR5 SODIMM Type-3 10L Signals Topologies</title><image href="../images/GUID-F207755C-D0BF-4EE0-8446-60DA0B8CAB07.png" scalefit="yes" id="IMG_DDR5_SODIMM_TYPE-3_10L_SIGNALS_TOPOLOGIES_1_PNG" /></fig><fig id="FIG_DDR5_SODIMM_BACK-TO-BACK_PLACEMENT_BLOCK_DIAGRAM_1"><title>DDR5 SODIMM Back-to-Back Placement Block Diagram</title><image href="../images/GUID-AA49CDCD-1329-42F8-AADE-5A55E950F432.png" scalefit="yes" id="IMG_DDR5_SODIMM_BACK-TO-BACK_PLACEMENT_BLOCK_DIAGRAM_1_PNG" /></fig><fig id="FIG_DDR5_SODIMM_SIDE-BY-SIDE_PLACEMENT_BLOCK_DIAGRAM_1"><title>DDR5 SODIMM Side-by-Side Placement Block Diagram</title><image href="../images/GUID-66705FAE-881C-494F-B969-C5032BE094C6.png" scalefit="yes" id="IMG_DDR5_SODIMM_SIDE-BY-SIDE_PLACEMENT_BLOCK_DIAGRAM_1_PNG" /></fig><fig id="FIG_DDR5_SODIMM_1DPC_TOP-PIN_BOTTOM-PIN_DEFINITION_AND_COMPENSATION_1"><title>DDR5 SODIMM 1DPC Top-Pin Bottom-Pin Definition and Compensation</title><image href="../images/GUID-CE029BA4-D9C3-4880-9812-245BCFEF4C66.png" scalefit="yes" id="IMG_DDR5_SODIMM_1DPC_TOP-PIN_BOTTOM-PIN_DEFINITION_AND_COMPENSATION_1_PNG" /></fig><table id="TABLE_B0E4F849-15E2-4CB7-8CF1-B9B4859B510A_1"><title>SODIMM 1DPC Notes</title><tgroup cols="2"><thead><row><entry>Note</entry><entry>Detail</entry></row></thead><tbody><row><entry><p>PCB stackup</p></entry><entry><p>Type-3 stackup with minimum of 10 layer.</p></entry></row><row><entry><p>Layer assignment rules</p></entry><entry><p>Follow the reference design (RVP).</p><p /></entry></row><row><entry><p>Reference plane</p></entry><entry><p>Continuous ground only.</p></entry></row><row><entry><p>Number of vias allowed</p></entry><entry><p>DQ/ DQS/ CA/ CS/ CLK: Max 2 vias. </p><p>RESET signal may have max 5 via.</p><p /></entry></row><row><entry><p>Ground stitching</p></entry><entry><p>For VSS stitching using microvia, target a minimum S:G ratio of 1:1 at signal layer transition.  </p><p>For VSS stitching using PTH, target a minimum S:G ratio of 2:1 at signal layer transition.</p><p>VSS via stitching pattern to be copied exactly from RVP / clip files.</p></entry></row><row><entry><p>Max MS BO/ BI length</p></entry><entry><p>Refer to RFI/ EMC guidelines for the max microstrip BO/ BI length requirement.</p></entry></row><row><entry><p>Serpentine routing</p></entry><entry><p>Use 3x of dielectric height for serpentine routing spacing.</p></entry></row><row><entry><p>Bit/ Byte swapping rule</p></entry><entry><p>Bit swapping is allowed within each Byte for all memory technologies. </p><p>DDR5: Byte Swapping is allowed within each x32 channel.</p><p /></entry></row><row><entry><p>MS BO and BI segment, PTH pattern</p></entry><entry><p>Keep DDR MS BO and BI as close as possible to reference board.</p></entry></row><row><entry><p>DDR to Non-DDR trace spacing</p></entry><entry><p>Minimum 500 um.</p></entry></row><row><entry><p>Unused signals</p></entry><entry><p>DDR signals on Processor which are not applicable for DDR5 can be left unconnected </p></entry></row><row><entry><p>Rtt/ Ctt for RESET</p></entry><entry><p>Keep R1 empty; R2 = 0 Ohm; C1 = 0.1 uF (no stuff).</p></entry></row><row><entry><p>RCOMP value</p></entry><entry><p>100 Ohm</p></entry></row><row><entry><p>CLK-to-CA/CS spacing</p></entry><entry><p>On L3 &amp; L5, CLK &amp; CA/CS may have a BO3 segment with CLK-to-CAC spacing of 375um after BO2</p></entry></row></tbody></tgroup></table><table id="TABLE_B0E4F849-15E2-4CB7-8CF1-B9B4859B510A_2"><title>Max number of vias</title><tgroup cols="2"><thead><row><entry>Signal Group</entry><entry>Max Number of Vias Allowed</entry></row></thead><tbody><row><entry><p>CA, CLK, CS, DQ, DQS</p></entry><entry><p>2</p></entry></row><row><entry><p>RCOMP</p></entry><entry><p>1</p></entry></row><row><entry><p>ALERT</p></entry><entry><p>2</p></entry></row><row><entry><p>RESET</p></entry><entry><p>5</p></entry></row></tbody></tgroup></table></section><section id="SECTION_SYSTEM_MEMORY_0D2567A7-00B5-48F8-BA9C-4B330204A25B_B0E4F849-15E2-4CB7-8CF1-B9B4859B510A_LENGTH_MATCHING"><title>Length Matching</title><table id="TABLE_SYSTEM_MEMORY_0D2567A7-00B5-48F8-BA9C-4B330204A25B_B0E4F849-15E2-4CB7-8CF1-B9B4859B510A_LENGTH_MATCHING_1" scale="60"><title>SODIMM 1DPC Length Matching</title><tgroup cols="9"><thead><row valign="top"><entry outputclass="rotate90">Signal Group</entry><entry outputclass="rotate90">Plus/Minus</entry><entry outputclass="rotate90">Reference Group</entry><entry outputclass="rotate90">Within/Group</entry><entry outputclass="rotate90">Up to memory/connector</entry><entry outputclass="rotate90">Length/Delay</entry><entry outputclass="rotate90">Min/Max/Range</entry><entry outputclass="rotate90">Min</entry><entry outputclass="rotate90">Max</entry></row></thead><tbody><row><entry><p>CLK_P</p></entry><entry><p>-</p></entry><entry><p>DQS</p></entry><entry><p>Channel (x32)</p></entry><entry><p>Same Connector</p></entry><entry><p>Length (mm)</p></entry><entry><p>Range</p></entry><entry><p>-38</p></entry><entry><p>63.5</p></entry></row><row><entry><p>DQ</p></entry><entry><p>-</p></entry><entry><p>DQS</p></entry><entry><p>Byte (x8)</p></entry><entry><p>Same Connector</p></entry><entry><p>Length (mm)</p></entry><entry><p>Range</p></entry><entry><p>-0.5</p></entry><entry><p>0.5</p></entry></row><row><entry><p>DQS</p></entry><entry><p>-</p></entry><entry><p>DQS</p></entry><entry><p>Pair (P-N)</p></entry><entry><p>Same Connector</p></entry><entry><p>Length (mm)</p></entry><entry><p>Max</p></entry><entry><p /></entry><entry><p>0.125</p></entry></row><row><entry><p>CLK_P</p></entry><entry><p